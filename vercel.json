{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/docs/REVE-Affiliate-How-To-Use.pdf",
      "destination": "/REVE-Affiliate-How-To-Use.pdf"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/fail-stale-pending-orders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/payment-reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}